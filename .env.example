# Copy this file to .env and fill local values. Never commit .env.

# Optional Meshtastic helper tools
MESHTASTIC_HOST=meshtastic.local
MESHTASTIC_TCP_PORT=4403
MESHTASTIC_SERIAL_PORT=
MAIL_NODE_ID=
MAIL_NODE_NAME=mail
TRIGGER_PREFIX=EMAIL:
TRIGGER_TOKEN=

# Optional SMTP fallback bridge
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=
EMAIL_TO=

# EMQX deployment API and MQTT credentials
EMQX_DEPLOYMENT_ID=
EMQX_DEPLOYMENT_API_BASE=https://your-deployment.example.com:8443/api/v5
EMQX_APP_ID=
EMQX_APP_SECRET=
MQTT_HOST=your-mqtt-host.example.com
MQTT_PORT=8883
MQTT_USERNAME=home
MQTT_PASSWORD=
MQTT_ROOT=msh/home

# Make.com webhook used by the legacy MQTT bridge
MAKE_API_BASE=https://us2.make.com/api/v2
MAKE_LORA_HOOK_ID=
MAKE_LORA_SCENARIO_ID=
MAKE_LORA_WEBHOOK_URL=

# Cloudflare Pages worker panel
RP_ID=mailbox.example.com
PANEL_SETUP_TOKEN=
PANEL_MQTT_URL=wss://your-mqtt-host.example.com:8084/mqtt
PANEL_MQTT_USERNAME=panel
PANEL_MQTT_PASSWORD=
PANEL_TOPIC_PREFIX=mailbox
PANEL_STALE_MINUTES=12
HC_API_KEY=
HC_CHECK_UUID=
CLOUDFLARE_ACCOUNT_ID=
