{
  "name": "@feierbuqiu/lora-mailbox-panel",
  "version": "0.2.1",
  "description": "Passkey-gated Cloudflare Pages Worker and MQTT status panel for the LoRa mailbox gateway, including calibrated battery telemetry compatibility.",
  "type": "module",
  "main": "src/worker.js",
  "files": [
    "src/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && npx wrangler pages deploy deploy",
    "check": "npm run build",
    "test": "node --test",
    "pack:inspect": "npm pack --dry-run"
  },
  "keywords": [
    "cloudflare-pages",
    "webauthn",
    "mqtt",
    "lora"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/feierbuqiu/lora-mailbox-gateway.git",
    "directory": "web-panel"
  },
  "bugs": {
    "url": "https://github.com/feierbuqiu/lora-mailbox-gateway/issues"
  },
  "homepage": "https://github.com/feierbuqiu/lora-mailbox-gateway/tree/main/web-panel#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.2"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
